# Loopback only. Use an SSH tunnel before configuring HTTPS and access control.
NEX_HTTP_PORT=3210
# Create nex/, codex/, projects/ beneath this directory; owner 10001:10001.
NEX_DATA_ROOT=/srv/nex/data
NEX_IMAGE_TAG=local
# Optional shared instance password. This is not multi-user isolation.
NEX_PASSWORD=

# Enable only behind a trusted reverse proxy; keep the host port loopback-only.
NEX_TRUST_PROXY=false

# Briefing agents: sandbox (default) or container (explicit opt-in).
# container removes inner OS filesystem/network isolation, NOT role tool checks.
# Use only in an administrator-managed isolated test container. Never auto-fallback.
NEX_BRIEFING_EXECUTION_MODE=sandbox
