{
  "name": "nex-web",
  "type": "module",
  "version": "0.1.0",
  "description": "Nex web workspace for conversational research and executive briefings",
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "nex",
    "agent",
    "research",
    "briefing",
    "bun",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Martin-CYL/MAS-for-Real-time-Monitoring-and-Executive-Briefings.git"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.3.5"
  },
  "scripts": {
    "build": "bun run build:client && bun run build:export-viewer && bun run build:server",
    "build:client": "vite build",
    "build:export-viewer": "vite build --config vite.export-viewer.config.ts",
    "build:server": "bun run ./scripts/build-server.ts",
    "check": "tsc --noEmit && bun run build",
    "dev": "bun run ./scripts/dev.ts",
    "dev:client": "vite --host 0.0.0.0 --port 5174",
    "dev:server": "bun run ./scripts/dev-server.ts --no-open --port 5175",
    "start": "bun run ./src/server/entry.ts",
    "test": "bun test",
    "start:production": "bun ./dist/server/entry.js"
  },
  "dependencies": {
    "@mariozechner/pi-ai": "0.73.1",
    "@mariozechner/pi-coding-agent": "0.73.1",
    "better-auth": "1.7.9",
    "cloudflared": "^0.7.1"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.277",
    "@anthropic-ai/sdk": "^0.123.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/bricolage-grotesque": "^5.2.10",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@pierre/diffs": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@shadcn/react": "^0.2.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bun": "latest",
    "@types/node": "^24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "autoprefixer": "^10.4.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "command-score": "^0.1.2",
    "default-shell": "^2.2.0",
    "file-type": "^22.0.0",
    "hast-util-to-jsx-runtime": "^2",
    "html-url-attributes": "^3",
    "lucide-react": "^0.562.0",
    "openai": "^6.34.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.7.3",
    "react-router-dom": "^7.12.0",
    "recharts": "3.8.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11",
    "remark-rehype": "^11",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "typebox": "^1.3.6",
    "typescript": "5.8.3",
    "unified": "^11",
    "unist-util-visit": "^5",
    "uqr": "^0.1.3",
    "vite": "^6.0.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.10"
  },
  "private": true
}
